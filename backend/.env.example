# Keep comments on their own lines: `docker run --env-file` does not strip
# trailing "# ..." comments the way python-dotenv does.

# ── Data ──────────────────────────────────────────────────────────────────────
# yfinance (default) or alpaca
DATA_PROVIDER=yfinance
ALPACA_API_KEY=your_alpaca_key_here
ALPACA_SECRET_KEY=your_alpaca_secret_here
# iex (free plan) or sip (paid)
ALPACA_FEED=iex
# ALPACA_BASE_URL is not currently read by any backend code (kept for future use)
ALPACA_BASE_URL=https://paper-api.alpaca.markets
# 0 = don't start the Alpaca live stream
# ENABLE_STREAM=0

# ── Server ────────────────────────────────────────────────────────────────────
FLASK_PORT=5000
# 0.0.0.0 to listen on all interfaces (docker-compose sets this)
# FLASK_HOST=127.0.0.1
# FLASK_DEBUG=1
# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── Auth (see backend/auth.py and docs/DEPLOY_AZURE.md) ───────────────────────
# Without auth settings, /api/* answers 503 ("fails closed"). For local work
# either disable auth (local development only — never in the cloud), or create
# a dev GitHub OAuth app with callback http://localhost:3000/auth/callback and
# fill in the block below instead.
AUTH_DISABLED=1
# >= 32 random chars: python -c "import secrets;print(secrets.token_urlsafe(48))"
# JWT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# Comma-separated GitHub logins, case-insensitive
# ALLOWED_USERS=your-github-login
# Where the browser reaches the app; the OAuth callback is PUBLIC_URL/auth/callback
# PUBLIC_URL=http://localhost:3000
# Only for plain-http localhost
# COOKIE_SECURE=0
# Bump to sign every session out
# TOKEN_VERSION=1

# Optional override for the RL signals directory (see CLAUDE.md "RL Signal Integration")
# RL_SIGNALS_DIR=
